{
  // Lock the reply language (auto, th, en, ja, zh, es). Factory auto follows the
  // conversation's language; a lock translates prose only — commands, paths,
  // identifiers and config keys stay verbatim.
  "language": "auto",
  // Handoff journal (the recovery core — this is the part that matters).
  "journal": {
    "outputDirectory": ".claude/coalhearth",
    "atomicityRetries": 3
  },
  // Resume-on-boot behavior.
  "recovery": {
    "autoInjectPrompt": true,
    "stashUnsavedChanges": true
  },
  // Self-update (orthogonal to the journal/resume hooks — its own off-switch).
  // The SessionStart hook only SCHEDULES a check via a throttled local stamp (no
  // network); the AGENT verifies the latest tag and offers `claude plugin update
  // coalhearth@coalhearth` (/coalhearth:update), consent-gated. updateMode: off =
  // no check is ever scheduled; ask, auto and remind all behave the same today (when
  // a check is due the hook prints one consent-gated offer; the agent is not told
  // which of the three is set).
  // updateCheckDays: days between checks (1-365; out-of-range clamps to 14 on read).
  "update": {
    "updateMode": "ask",
    "updateCheckDays": 14
  }
}
